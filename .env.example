# Do not commit a real token. Set these in Railway -> Variables, and Seal the secrets there (TELEGRAM_BOT_TOKEN,
# PREDICT_PRIVATE_KEY, PREDICT_API_KEY, WEB_CONTROL_KEY): the bot reads them from the environment only.
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
# 0 means setup-only. Send /id to the running bot, then replace 0 with your user ID.
ADMIN_USER_ID=0
SYMBOLS=UNITREEUSDT,HK0625USDT,CXMTUSDT,SKHYNIXUSDT
# 1 means 1%, not 0.01. Equality does NOT trigger.
ALERT_THRESHOLD_PCT=1
POLL_SECONDS=5
# Realtime stock quotes while a stock's session runs (1-300 s; the A-share / HK stocks share one request). Indices are
# fixed: SSE/A50 and KOSPI every 10 s in session, HSI 20 s, 60 s when shut.
QUOTE_REFRESH_SECONDS=1
ALERT_COOLDOWN_SECONDS=300
# 1 means another alert at each additional percentage-point band.
# 0 disables expansion alerts. A 30-second minimum gap still applies.
ALERT_STEP_PCT=1
MIN_ALERT_GAP_SECONDS=30
MAX_PRICE_AGE_SECONDS=120
# binance_daily = previous completed Binance UTC daily close, NOT stock official close.
# exchange_close = Binance contract price at the underlying exchange's latest close (same instant as the exchange close).
# manual = user supplied, same-quote-unit reference, valid for one Beijing calendar day.
BASELINE_MODE=exchange_close
# Requires a Railway Volume mounted at /data for persistence.
STATE_DB=/data/bot.sqlite3
# Underlying stock of each contract, for the automatic "证券交易所收盘价" line (read-only public daily bars).
# Format: SYMBOL=market:code[:same]; markets sh/sz (Eastmoney A-share), hk (Eastmoney HKEX), kr (Naver KRX).
# Append :same when the contract is quoted in the stock's own currency so a deviation is computed. off disables.
EXCHANGE_TICKERS=UNITREEUSDT=sh:688836,HK0625USDT=hk:00625:same,CXMTUSDT=sh:688825,SKHYNIXUSDT=kr:000660
# Optional: FX overrides (units per 1 USD) used to convert exchange closes; otherwise fetched from Frankfurter/ECB.
# FX_RATES=CNY=7.12,HKD=7.79,KRW=1390
# cn = 红涨绿跌 (default), us = 绿涨红跌
COLOR_STYLE=cn
# Hang Seng Index futures quote (incl. 17:15-03:00 after-hours) in /status and HK alerts; off disables.
HSI_FUTURES=on
# Hyperliquid reference markets: SYMBOL=dex:COIN (HIP-3 dex such as xyz; omit dex: for the main perp dex). off disables.
HL_TICKERS=UNITREEUSDT=xyz:UNITREE,HK0625USDT=xyz:SHEIN,CXMTUSDT=xyz:CXMT,SKHYNIXUSDT=xyz:SKHX
# KOSPI composite index in /status and Korea alerts; off disables.
KOSPI_INDEX=on
# Hyperliquid index perps compared with the cash index (KR200 = KOSPI 200); off disables.
HL_INDEX=KR200=xyz:KR200
# HL_REFRESH_SECONDS=10: how often the Hyperliquid quotes are read (3-120; the KR200 perp is the KOSPI card's after-hours price)
# HL_REFRESH_SECONDS=10
# The price streams beside the REST reads (1.87.0): Binance's trade streams for the contracts (with the mark price every
# second) and the crypto cards' pairs, Hyperliquid's context stream for the perps quoted; off = REST only. Needs websockets.
# BINANCE_WS=on
# HL_WS=on
# BINANCE_WS_URL (1.89.0): the futures stream's server(s), comma-separated, tried in turn (the bot appends /ws or
# /stream?streams=...). Empty = wss://fstream.binance.com. Point it at a relay when the connection is made but no data arrives.
# BINANCE_WS_URL=wss://fstream.binance.com
# Close-direction probabilities in /status and /prob; off disables. PROB_VOL overrides daily σ in percent.
PROBABILITY=on
# PROB_VOL=UNITREEUSDT=3.5,HSI=1.2,KOSPI=2
# A daily card's σ ahead is widened once the day's move (effective price vs the reference close) passes this many daily σ,
# in proportion and at most twice: the daily closes behind σ know nothing of the day's own swings. 0 = never.
# PROB_BIG_MOVE_SIGMAS=1.5
# The SSE card's in-session σ this many times wider on top of SIGMA_CALIB's factor (1.154.69; 1–3, 1 = none). 1.154.79: back to 1 —
# the 1.5 made the model buy the far side of a trending day (11-27: 跌 at 1¢ with the index up 1.9%).
# SSE_SIGMA_EXTRA=1
# The trader judges these cards' sides by their fair price taken this far toward the market's own (the Predict book's middle;
# one-sided: that side's own bid, else 0): KEY:weight, 0 = the model alone, 0.5 = halfway, 1 = the market's (never an edge).
# Unset: SSE:0.5 (1.154.79 — over 33 days of 上证 the market was the better judge); none = no card.
# SIM_MARKET_BLEND=SSE:0.5
# Shanghai Composite with FTSE China A50 futures as after-hours proxy. A50_BETA (Composite move per 1% of A50) is the
# prior: with A50_BETA_DYNAMIC=on the bot blends it with the slope fitted on its own after-hours record (see README).
SSE_INDEX=on
A50_BETA=0.8
A50_BETA_DYNAMIC=on
# KOSPI move per unit of HL KR200 move after hours (default 1); check /calib before changing it. With
# KOSPI_BETA_DYNAMIC=on (the default, 1.117.0) it is the prior the bot blends with the slope fitted on its own after-hours
# record, as for A50; off = KOSPI_BETA fixed.
# KOSPI_BETA=1
# KOSPI_BETA_DYNAMIC=on
# Weekday exchange holidays (target dates skip them); ranges allowed. Only certain dates. The built-in tables (the values
# below, 1.154.77) reach 2028-01-01 from each 2027 notice: set these only to change them — a value here replaces the built-in
# table. /status and the startup log warn 30 days before the table runs out.
HOLIDAYS_CN=2026-09-25,2026-10-01..2026-10-07,2027-01-01..2027-01-03,2027-02-05..2027-02-13,2027-04-03..2027-04-05,2027-05-01..2027-05-05,2027-06-09,2027-09-15,2027-10-01..2027-10-07,2028-01-01
HOLIDAYS_KR=2026-09-24,2026-09-25,2026-10-05,2026-10-09,2026-12-25,2026-12-31,2027-01-01,2027-02-08,2027-02-09,2027-03-01,2027-05-03,2027-05-05,2027-05-13,2027-07-19,2027-08-16,2027-09-14..2027-09-16,2027-10-04,2027-10-11,2027-12-27,2027-12-31,2028-01-01
HOLIDAYS_HK=2026-10-01,2026-10-19,2026-12-25,2027-01-01,2027-02-08,2027-02-09,2027-03-26,2027-03-29,2027-04-05,2027-05-13,2027-06-09,2027-07-01,2027-09-16,2027-10-01,2027-10-08,2027-12-27,2028-01-01
# Days with a different session: HKEX half days (close 12:10, HSI futures 12:30, no night session) and KRX days that run
# one hour late (the CSAT day: 10:00–16:30). Comma-separated dates; empty = none.
HK_HALF_DAYS=2026-12-24,2026-12-31,2027-02-05,2027-12-24,2027-12-31
KR_LATE_DAYS=2026-11-19
# SGX (the A50 futures): no session on a Singapore holiday; a half day trades the morning only (to 12:00, no T+1 session).
HOLIDAYS_SG=2026-01-01,2026-02-17,2026-02-18,2026-04-03,2026-05-01,2026-05-27,2026-06-01,2026-08-10,2026-11-09,2026-12-25,2027-01-01,2027-02-08,2027-03-10,2027-03-26,2027-05-17,2027-05-20,2027-08-09,2027-10-28,2028-01-01
SG_HALF_DAYS=2026-02-16,2026-12-24,2026-12-31,2027-02-05,2027-12-24,2027-12-31
# CME Globex holiday schedules (gold and oil, the pre-open mode's CME cards; 1.151.0): an early halt of metals and energy — the
# pre-open mode takes the window from 12:00 New York time on as shut — and the days with no session (the evening before to the
# next reopen). Listed wide on purpose; CME fixes the exact times about two weeks ahead. Empty = none.
CME_EARLY_DAYS=2026-11-26,2026-11-27,2026-12-24,2026-12-31,2027-01-18,2027-02-15,2027-05-31,2027-06-18,2027-07-05,2027-09-06,2027-11-25,2027-11-26
CME_CLOSED_DAYS=2026-12-25,2027-01-01,2027-03-26,2027-12-24
# Predict.fun daily up/down orderbooks compared with the model (/book, /prob, web page); off disables.
PREDICT=on
# Optional API key for api.predict.fun (sent as x-api-key); set it if /book shows HTTP 401/403.
# PREDICT_API_KEY=
# Ask graphql.predict.fun at all (the category lookup, the start price). Predict retired the endpoint (HTTP 403 everywhere by
# 2026-11): off = REST alone, no probe in /diag; the market lists and a window's start price come from the REST category.
# PREDICT_GRAPHQL=off
# Orderbook refresh interval, 3-3600 s (the control page can change it). Too short and Predict answers 429: no request for 20 s.
# (1 to 3600; the pushed books apply at once, this is the REST backstop — under 2 risks a 429 that blocks every book read for 20 s)
# PREDICT_POLL_SECONDS=10
# Predict's WebSocket (wss://ws.predict.fun/ws): the hot markets' books pushed as they change, beside the REST rounds, which
# go on as before; off = REST only. Needs the websockets package (requirements.txt); the API key above is sent on connect.
# PREDICT_WS=on
# Markets nothing is near on (most ladder levels) are refreshed only every this many seconds (3-80).
# PREDICT_COLD_POLL_SECONDS=60
# Quote sources never asked, comma-separated: eastmoney, sina, tencent, yahoo, naver, etnet. Eastmoney refuses most
# overseas boxes (502 / closed connection); switch it off and the others stand in (the control page can do it too).
# SOURCES_OFF=eastmoney
# Referral code appended to Predict market links (?ref=); empty = none.
# PREDICT_REF_CODE=B00EA
# Edges are net: takers pay fee x min(p, 1-p) (the market's own feeRateBps, else PREDICT_FEE_BPS) and walk the book for
# PREDICT_TRADE_USD; a suggestion needs PREDICT_MIN_EDGE_CENTS or the model's own error, whichever is larger.
# PREDICT_FEE_BPS=200
# PREDICT_TRADE_USD=100
# PREDICT_MIN_EDGE_CENTS=2
# Telegram edge alerts to subscribed chats: a suggestion reaching EDGE_ALERT_CENTS (new), the announced side no longer
# suggested (gone) or the other side suggested instead (flip); each change must hold EDGE_ALERT_CONFIRM_SECONDS, and the
# same market and side is announced as new again only after EDGE_ALERT_COOLDOWN_SECONDS. EDGE_ALERT=off disables.
# EDGE_ALERT=on
# EDGE_ALERT_CENTS=10
# EDGE_ALERT_CONFIRM_SECONDS=60
# EDGE_ALERT_COOLDOWN_SECONDS=900
# Digest mode: the new-opportunity alerts are gathered into one message per period, grouped by the event they settle
# on (a ladder's levels are one entry); gone / flip alerts still go at once. 0 = one message per opportunity.
# EDGE_ALERT_DIGEST_MINUTES=0
# SIM_DAILY_REPORT: the Beijing time (HH:MM) the day's trading report goes to every subscription — what was ordered and
# settled today, the open positions and their unrealized P&L at the books' middles, the lifetime, the busiest
# underlyings, the resting orders' fill rate, the review page's link. Once a day; a bot that was down at the hour
# sends it within 6 hours; a day with nothing ordered, settled, held or resting sends nothing. off = none.
# SIM_DAILY_REPORT=16:30
# Paper trading (/sim): what it trades (SIM_MARKETS=all or close,touch,updown,flip,range,ladder; SIM_WAYS taker/maker/both),
# the net edge that triggers a paper buy and its size, and the most one group of positions (the same settling event:
# one token's ladder, one Binance pair, one index on one day) may lose on a single move. 0 = no limit.
# SIM_MARKETS=close
# SIM_SKIP: markets left out within those kinds (comma-separated keys such as HSI,UNITREEUSDT,BNB; the control page's
# 做哪些市场 card lists them as chips under 展开详细选项). Empty = every market of the chosen kinds.
# SIM_SKIP=
# SIM_WAYS=taker
# SIM_EDGE_CENTS=10
# SIM_SHARES=100
# Takers alone: shares per buy in session (0 = SIM_SHARES) and after hours (0 = the in-session taker count). Makers keep SIM_SHARES.
# SIM_TAKER_SHARES=0
# SIM_TAKER_AFTER_HOURS_SHARES=0
# A market's side is taken again while its takers' fills stay under this total (the last buy takes the remainder); 0 = once only.
# SIM_TAKER_MAX_SHARES=300
# Every ask at or under the cap in one order (asks at 20c and 30c both clearing the bar are both taken), up to this many
# shares and never fewer than the per-buy count; the per-buy count when the group cap or the real-trading limits refuse it. 0 = off.
# SIM_TAKER_SWEEP_SHARES=300
# A side whose fair price is over this many cents is judged at this many, no higher (1.85.0; before, not bought at all): a
# near-certain outcome has a tail a normal model cannot see, so it is bought or quoted only when the price leaves the bar
# under the limit (99.6c fair, 85c ask: judged as 95 - 85.3). 100 = as the card says (far ladder levels often sit above 95).
# SIM_MAX_FAIR_CENTS=95
# After hours (the card priced from a proxy) a market's side holds at most this many shares, positions and orders
# together: an order is cut to the room left, none when there is none. In session no limit. Deep-bid orders
# (SIM_MAKER_DEEP_CENTS) are outside it: placed whatever the side holds, their unfilled shares not counted. 0 = off.
# SIM_AFTER_HOURS_MAX_SHARES=300
# The two share caps above count a side's net position (1.91.0): what it holds (after hours with its resting orders) less
# the other side's fills — 400 Up against 400 Down is flat, so a 500 cap leaves 500 more on either side; the other side's
# resting orders offset nothing. off = each side on its own. Net means no cap on both sides together: only the group cap,
# the real-trading limits and the balance bound a hedged pile bought on a proxy price swinging both ways.
# SIM_SHARES_NET=on
# σ times a factor measured on the actual outcomes (SIGMA_CALIB; off = the estimate alone): the 15-minute cards on their
# windows, the daily crypto cards pooled, the index cards on /calib's snapshot residuals (盘中 / 盘后 apart; their factor
# within 0.6–2.0 with a 5-day prior at 1 since 1.121.0 (10 in 1.117.0), the others' within 0.5–2.0 with 10 windows (0.7–1.4
# with 20 before 1.121.0). The 15-minute cards' σ itself follows the shape of the day since 1.121.0: the last hours' level
# over what those hours usually show, times the window's quarter hour's usual (the last 14 days' 15-minute candles).
# 1.154.69: the stock cards' factors too (measured as the index cards', 盘中 / 盘后 apart), each applied only where /calib's
# walk-forward check of that card and mode scores the scaled σ better than the plain one
# SIGMA_CALIB=on
# A 15-minute card priced on its stock's own exchange quote (LEAD_QUOTE, 1.108.0): the index at the window's start times the
# realtime quote's ratio to its own start price — Binance's index runs seconds to a minute behind the exchange, and the
# sellers hitting the bot's bids had seen the move. shadow = record both prices in the samples, trade on the index (/calib
# compares them); off = the index alone. The windows still settle on the index (Chainlink).
# LEAD_QUOTE=on
# No new order on a daily card for this many minutes before and after its underlying opens (the day's first session and
# the afternoon one), and a resting order is withdrawn for the window — placed afresh on the new fair price after it (the
# feeds lag most around the opening auction; an overnight order left through the open is a free option). 0 = off.
# SIM_OPEN_QUIET_MINUTES=3
# A daily stock card's side the day's move has gone against by this many daily σ (the live print in session, the proxy after
# hours) is not bought and a resting order there is withdrawn (1.120.0: the model is driftless; SK Hynix 涨 was bought at 10¢ with
# the stock −10% on the day). 0 = never (the default). SIM_AGAINST_MOVE_INDEX=on applies it to the index cards too (off: /calib says
# they recover).
# SIM_AGAINST_MOVE_SIGMAS=0
# SIM_AGAINST_MOVE_INDEX=off
# A resting order on a market the bot cannot price now (the card's odds missing — the SSE card over a weekend with the A50
# closed — or its suggestion held) is withdrawn once that has lasted this many minutes, deep-bid orders included, and placed
# afresh when the odds return (1.92.0; no new order goes on such a market anyway). 0 = it stands.
# SIM_NO_ODDS_WITHDRAW_MINUTES=30
# SIM_VIEW_COPY=on: the trader's views of its records are copies again, made at once, as before 1.154.41 (now a view reads
# the kept records in place and copies only when it or they change; /diag's 模拟交易 line counts both). Only as a way back.
# SIM_VIEW_COPY=off
# SIM_SECONDS=5: every 5 s (3-60) the books are judged, orders placed / withdrawn and the real orders read back (the control
# page can change it). PREDICT_POLL_SECONDS shorter than this is pointless.
# SIM_SECONDS=5
# SIM_GROUP_USD=300 (an order the cap does not take whole is cut to what fits; refused only when not a share fits). In real
# trading a taker counts as its whole LIMIT order (every share asked for, at the limit plus the fee), and an order whose
# cancel Predict has not confirmed still counts.
# SIM_TAKER_SESSION=on: daily cards (index / stock up-or-down) are taken only while the underlying trades (the card is priced
# from the spot, not an after-hours proxy; the lunch break counts as after hours); makers rest at any time. Crypto cards
# are not affected.
# SIM_TAKER_SESSION=off
# SIM_TAKER_AFTER_HOURS_CENTS=15: after-hours taker mode — a daily card is also taken outside its session, but only with this
# much net edge (never under SIM_EDGE_CENTS). 0 = off. SIM_AFTER_HOURS_MAX_PRICE_CENTS: outside the session a daily card's
# orders, taker and maker, only at or under this price (default 60; 0 = no limit).
# SIM_TAKER_AFTER_HOURS_CENTS=0
# SIM_AFTER_HOURS_MAX_PRICE_CENTS=60
# SIM_TAKER_AFTER_HOURS_MARKETS: after hours only these daily cards are taken (comma-separated keys; the control page's
# 盘后吃单模式 card lists them as chips), whatever SIM_TAKER_SESSION says; in session every market. Empty = all.
# SIM_TAKER_AFTER_HOURS_MARKETS=
# SIM_QUIET_MINUTES=15: from 15 minutes before a market's end (the underlying's close, a deadline) no new order is placed
# and unfilled resting orders are withdrawn (real trading cancels them on Predict); 0 = off.
# SIM_QUIET_MINUTES=0
# The daily crypto up/down markets (BTC / ETH / BNB "up or down on <date>", settled on the 12:00 ET candle; kind updown),
# in beta: one buy, taker or maker, asks for at most SIM_CRYPTO_DAY_SHARES shares; each side of one market holds at most
# SIM_CRYPTO_DAY_MAX_SHARES, its positions and orders together, each side its own cap (a buy is cut to what is left);
# nothing is bought in its last SIM_CRYPTO_DAY_QUIET_MINUTES (the longer of this and SIM_QUIET_MINUTES), resting orders
# withdrawn; SIM_CRYPTO_DAY_EDGE_CENTS is their own entry bar (0 = SIM_EDGE_CENTS). 0 = no limit of its own (the general
# settings alone). /calib's threshold backtest scores every bar from 2¢ to 20¢ on what these markets then did.
# SIM_CRYPTO_DAY_SHARES=10
# SIM_CRYPTO_DAY_MAX_SHARES=100
# SIM_CRYPTO_DAY_QUIET_MINUTES=30
# SIM_CRYPTO_DAY_EDGE_CENTS=0
# The 15-minute up/down markets (宇树 UNITREE and SK 海力士 SKHYNIX "up or down 15m", <coin>-updown-15m-<window start>, a
# market every quarter hour of the stock's exchange session, settled on Binance's USDⓈ-M futures index price that
# Chainlink streams; kind updown), in beta: one buy asks for at most SIM_CRYPTO_15M_SHARES;
# each side of one window holds at most SIM_CRYPTO_15M_MAX_SHARES (positions and orders together, each side its own cap);
# no order of any kind goes out in a window's last SIM_CRYPTO_15M_QUIET_SECONDS (the final minute never), resting orders withdrawn —
# SIM_QUIET_MINUTES does not apply to them; SIM_CRYPTO_15M_EDGE_CENTS is their own entry bar (0 = SIM_EDGE_CENTS).
# No new resting order goes on in a window's last SIM_CRYPTO_15M_MAKER_QUIET_SECONDS (takers and the orders already resting
# as they were; a re-quote there only withdraws): the ones placed with under three minutes left lost (1.116.0). 0 = none.
# SIM_CRYPTO_15M_SHARES=10
# SIM_CRYPTO_15M_MAX_SHARES=100
# SIM_CRYPTO_15M_QUIET_SECONDS=90
# SIM_CRYPTO_15M_MAKER_QUIET_SECONDS=180
# SIM_CRYPTO_15M_EDGE_CENTS=0
# ...and a card's unsettled windows hold at most this much together — positions at cost, orders (a cancel not yet
# confirmed too) at their price (SIM_CRYPTO_15M_OPEN_USD, 1.110.0; 0 = no cap). The share cap is one window's, both sides
# together and nothing netted; a floor order over the count a buy is not placed on these markets.
# SIM_CRYPTO_15M_OPEN_USD=100
# Resting orders: join the first bid level holding SIM_MAKER_MIN_BID shares besides ours (a thinner 买1 is not followed) and
# follow it when it moves a cent (0 = the top bid, no following); withdraw when the edge falls under SIM_MAKER_EXIT_CENTS
# (0 = never); SIM_MAKER_SESSION=on keeps a daily card's resting orders to its underlying's session (withdrawn before the
# open and over the lunch break, which is under the after-hours rules). An order withdrawn by these rules with nothing
# filled frees its slot and is placed again when the chance returns. SIM_MAKER_DEEPER=on: when that 买1 leaves less edge than the
# bar, the order waits at the first deeper level (买2, 买3…, holding SIM_MAKER_MIN_BID shares besides ours) that clears it, for a
# seller who sells through 买1; each side on its own (off = 买1 or nothing).
# SIM_MAKER_MIN_BID=100
# Floor orders (1.105.0): on a side with no bid to follow (an empty book, bids all under SIM_MAKER_MIN_BID), a bid of
# SIM_MAKER_FLOOR_SHARES shares rests at SIM_MAKER_FLOOR_CENTS — at least Predict's $1 minimum order (100 shares at 1¢) — for a
# seller dumping into the empty side; it follows a 买1 that appears and is outside the per-side caps while it rests; 0 = none.
# SIM_MAKER_FLOOR_SHARES=100
# SIM_MAKER_FLOOR_CENTS=1
# SIM_MAKER_FLOOR_MARKETS=
# SIM_MAKER_DEEPER=on
# SIM_MAKER_EXIT_CENTS=5
# A re-quote (the 买1 moved, a deep-bid order pushed off the front, a sweep order's bids changed) waits until the new place has
# held SIM_MAKER_FOLLOW_SETTLE_SECONDS: a market maker re-posting its stack every half second is not chased look by look
# (a withdrawal for the edge gone acts at once); 0 = at once.
# SIM_MAKER_FOLLOW_SETTLE_SECONDS=2
# A sweep order's move UP — over somebody's bid under the threshold ("下面的买单变了，击穿单改挂") — waits
# SIM_MAKER_SWEEP_SETTLE_SECONDS instead (1.154.50; 0–600, never less than the one above, 0 = the one above): two quoters
# by the "a cent over the other" rule climb over each other to the threshold and down again without end, three requests
# a re-quote (11-25: 1.25 a second on 11 slots, all of the key). While it waits the other's order is the one in front.
# Its moves down (the bid under it gone, the fair price fallen) and every withdrawal for the edge go as before.
# SIM_MAKER_SWEEP_SETTLE_SECONDS=30
# SIM_MAKER_SESSION=on
# SIM_MAKER_AFTER_HOURS_CENTS=10: after-hours maker mode — a daily card's resting orders are also placed before the open and
# after the close, but only with this much net edge (never under SIM_EDGE_CENTS); withdrawn a cent under it. 0 = off.
# SIM_MAKER_AFTER_HOURS_CENTS=0
# SIM_MAKER_SPREAD_CENTS=10: resting orders only on two-sided books no wider than this; 0 (default) = any book, one-sided too.
# SIM_MAKER_SPREAD_CENTS=0
# SIM_MAKER_DEEP_CENTS=25: deep-bid mode — an order whose net edge at a cent above the valid 买1 is at least this (never
# under SIM_EDGE_CENTS) is placed there, at the front of the book (a cent for being filled first), e.g. a 6¢ bid over a
# 5¢ 买1 under a 38¢ fair price; a book wider than SIM_MAKER_SPREAD_CENTS gets only such orders. 0 = off.
# SIM_MAKER_DEEP_ONLY=on: only those orders — nothing joins the 买1 queue at the ordinary bar.
# SIM_MAKER_DEEP_ONLY=off
# SIM_MAKER_DEEP_CENTS=0
# Each mode can be limited to chosen markets (comma-separated keys; the control page's mode cards list them as chips).
# Empty = every market the mode would otherwise apply to.
# SIM_MAKER_AFTER_HOURS_MARKETS=
# SIM_MAKER_DEEP_MARKETS=
# Deep-only on these markets only (comma-separated keys; elsewhere both kinds of resting order). Empty = wherever the mode is on.
# SIM_MAKER_DEEP_ONLY_MARKETS=
# SIM_MAKER_POINTS=on: resting orders only on markets whose Predict points pay now (the market page's "points active");
# withdrawn when they stop; nothing is placed while the status is unknown.
# SIM_MAKER_POINTS=on
# Slug stem per item; the date part (-up-or-down-on-september-28-2026) follows the model's target close.
# PREDICT_SLUGS=HSI=hang-seng-index,KOSPI=kospi-composite-index,SSE=sse-composite-index,UNITREEUSDT=unitree,HK0625USDT=shein,CXMTUSDT=cxmt,SKHYNIXUSDT=sk-hynix-inc
# Read-only probability web page. Railway injects PORT and RAILWAY_PUBLIC_DOMAIN once a domain is generated.
# WEB=off disables; WEB_PORT / WEB_BASE_URL for other hosts; WEB_TOKEN pins the secret path (16-64 chars).
# WEB_TOKEN=

# A US stock "hits $X by <date>" card (none listed since 1.112.3: STRC 触及 $100 is over) reads its deadline from the
# Predict title; pin it by hand as
# <STOCK_HIT_MARKETS key>=<YYYY-MM-DD> (23:59 ET of that day) when the title cannot be read. Several: separate with ;
# A pinned date Predict lists no market for prices nothing (the card says so): another deadline's market is never priced to it.
# The one market whose title names no date is priced to the pin (what the pin is for); with several such, none is.
# LADDER_DEADLINES=STRC-100=2026-12-31

# ---- Real trading on Predict (live.py) ------------------------------------------------------------------------------
# LIVE=on sends every paper-trading decision (/sim: SIM_EDGE_CENTS, SIM_SHARES, SIM_WAYS, SIM_MARKETS, SIM_GROUP_USD) to
# Predict as a real order. Keep it off until `python main.py --live-check` is clean. Never commit a private key.
# The initial real-trading mode: off = paper only; pause = signed in, checks, the order test and cancels work, no new
# position; on = real orders. With PREDICT_PRIVATE_KEY set the module always loads and the mode is switched while running
# (/live mode off|pause|on, or the control page) and saved; this variable is only the starting value.
LIVE=off
# The deployment's hard switch: off caps the effective mode at pause whatever the database saved (the page's LIVE=on
# included) and stops pending orders from going out. Flip this for an emergency stop; a cancel of the resting orders is
# still your call (/live cancel all or account).
# LIVE_TRADING_ALLOWED=on
# Predict refuses an order worth less than about 1 USD ("at least 0.9 USD"): SIM_SHARES × price must reach it, or the
# decision is refused and the reason recorded. Its trading endpoints also answer 403 from restricted regions (the US among
# them): deploy the service in a permitted region.
# The signing wallet's private key: a plain wallet, or the Privy wallet exported from the Predict website (account
# settings) when trading through a Predict account. 64 hex characters, 0x optional.
# PREDICT_PRIVATE_KEY=
# Trading through the Predict account (smart wallet) the key controls: its deposit address from the website's account
# settings. Leave empty to trade from the plain wallet's own address (it then holds the USDT and the shares).
# PREDICT_ACCOUNT=0x...
# 56 = BNB mainnet (default), 97 = BNB testnet.
# PREDICT_CHAIN_ID=56
# JSON-RPC node for balances, allowances, approvals and redeeming; empty = the chain's public node.
# BSC_RPC_URL=https://bsc-dataseed.bnbchain.org/
# Takers are LIMIT orders for SIM_SHARES at the dearest level the quote walks (LIVE_TAKER_PRICE=book) or at the cap, the
# dearest price that still keeps the required edge after the fee (cap): the book at or under it fills at once, the rest
# is cancelled after LIVE_TAKER_WAIT_SECONDS, or sooner once the fair price moves so the limit no longer keeps the edge.
# No MARKET orders (the former LIVE_TAKER and LIVE_SLIPPAGE_BPS are gone). Makers rest as LIMIT orders until withdrawn or settled.
# LIVE_TAKER_WAIT_SECONDS=60
# LIVE_TAKER_PRICE=book
# A market and side whose order Predict refused (or whose send broke) is not tried again for this long.
# LIVE_RETRY_SECONDS=300
# ...whose taker filled nothing (the timer, or the bot withdrawing the rest once the fair price moved) or whose decision
# was dropped at the pre-send re-check: the chance may be back in seconds (1.90.0; before, these waited LIVE_RETRY_SECONDS too).
# LIVE_TAKER_RETRY_SECONDS=30
# Hard limits above the strategy: per order, open exposure (positions plus resting orders, at cost), realised loss per
# Beijing day (new orders stop for the day, resting orders are cancelled; /live resume overrides).
# Orders per page when the account's open list is read each step (10-500; a page is a round trip; try 100 if Predict takes it)
# LIVE_ORDERS_PAGE=50
# LIVE_MAX_ORDER_USD=100 (a taker counts cap x shares; an order over a limit is cut to the shares the limit takes)
# LIVE_MAX_OPEN_USD=500
# LIVE_MAX_DAILY_LOSS_USD=200
# Redeem resolved winning positions for USDT on-chain (gas in BNB from the signing wallet); Telegram lines per order.
# LIVE_AUTO_REDEEM=on
# LIVE_NOTIFY=on
# An open order on the account that no record here placed, on a market this bot trades (a lost record's order), is
# withdrawn after two minutes; one on a market neither strategy touched (a manual order) is only reported
# LIVE_ORPHAN_CANCEL=on

# ---- Web control page (/p/<token>/control) ---------------------------------------------------------------------------
# The secret every action on the control page carries (12-64 ASCII characters, no spaces): pause / resume / cancel /
# redeem for real trading, and settings changed while running (saved, applied at once). Empty = the page is read-only.
# WEB_CONTROL_KEY=

# ---- Optional fixed pre-open quoting (read PREOPEN.md) --------------------------------------------------------------
# Every setting below can also be changed on the control page (the "开盘前预挂" group) and takes effect at once there.
# Off by default (PREOPEN_EXCLUSIVE=on holds the model trader's new orders while it runs). Run /preopen probe first: it
# asks each coming window and says which fields are there and which windows would be placed now. A restart or a settings
# change leaves the orders on the book (taken over, or withdrawn and quoted again); switching off withdraws them.
PREOPEN_15M=off
PREOPEN_POLL_SECONDS=5
# The cards quoted: btc (the default: BTC alone), eth, bnb, skhynix, unitree, btc5 / eth5 / bnb5 (the 5-minute cards),
# btc1h / eth1h / bnb1h (the hourly markets), btc1d / eth1d / bnb1d (the daily markets, 12:00 ET to 12:00 ET), a comma list,
# all = every card, or none = no card
# (the page's 一键全关: the mode stays on, the resting pairs are withdrawn)
PREOPEN_MARKETS=btc
# off = no window starting Saturday 00:00 to Monday 08:00 (Beijing time) is quoted, resting ones withdrawn — of every card: besides
# BTC / ETH / BNB, the US stock cards' Friday afternoons (from 11:00 New York, 12:00 in summer), gold's and oil's Friday close and
# their Monday reopen fall in it too (1.154.80: these words corrected; what it does is unchanged)
PREOPEN_WEEKEND=on
# Each side: PREOPEN_SHARES shares (default 10, the trial size) bid at PREOPEN_PRICE_CENTS (1–50¢; a side must reach Predict's $1 minimum)
PREOPEN_SHARES=10
PREOPEN_PRICE_CENTS=49
# Deeper bids under the first level, price x shares from the second level on (prices falling, at most 4 more), e.g.
# 48x20,47x40; each level is its own record. They are placed only within PREOPEN_DEEP_AHEAD_MINUTES of the start
# (0 = as the first level, which keeps the wide horizon for its queue position) — the money they tie up adds up
PREOPEN_LEVELS=
PREOPEN_DEEP_AHEAD_MINUTES=0
# A stock card (海力士, 宇树) is not quoted, its resting pairs withdrawn, while the exchange price is within this of the
# day's limit up or down (the previous close ± 30% KRX / 20% STAR) or trading is halted; 0 = off
PREOPEN_LIMIT_GAP_PCT=2
# A stock card's windows starting within this many minutes of a session segment's open (the day's open, the afternoon's)
# are not quoted: the opening auction's indicative price and the lunch break's news are public before the index moves; 0 = all
PREOPEN_OPEN_QUIET_MINUTES=15
# Only windows starting within this many minutes are placed, the soonest first (3–1440; the default 1440 = every window
# listed for the next day — the discovery stays cheap at that width). Lower it to tie up less money
PREOPEN_AHEAD_MINUTES=1440
# The cancel goes out this long before the window's start, then every 2 s until the signed expiry (the backstop when
# a cancel cannot get through); no new pair within PREOPEN_ENTRY_SECONDS of the start. /preopen measures the round trip
PREOPEN_CANCEL_SECONDS=20
PREOPEN_EXPIRY_SECONDS=10
PREOPEN_ENTRY_SECONDS=180
# BTC 5-minute's own (1.152.0): the four above for the BTC 5-minute card alone, each 0 = the general one. Its values together
# (a 0 counted as the general one) follow the same rules: expiry 5–600 s, cancel at least 5 s earlier, entry cut-off at least 60 s earlier
PREOPEN_BTC5_CANCEL_SECONDS=0
PREOPEN_BTC5_EXPIRY_SECONDS=0
PREOPEN_BTC5_ENTRY_SECONDS=0
PREOPEN_BTC5_AHEAD_MINUTES=0  # 1440 = 挂满 (1.152.2): every listed BTC 5-minute window, each placed the moment Predict lists it (the front of the queue)
PREOPEN_BTC5_PRICE_CENTS=0    # 1.154.56: BTC 5-minute's first level by itself — its price in cents (0 = PREOPEN_PRICE_CENTS)...
PREOPEN_BTC5_SHARES=0         # ...and its shares a side (0 = PREOPEN_SHARES)
PREOPEN_BTC5_DEEP_LEVELS=     # ...and its deeper levels, price x shares from the second level on, e.g. 43x40,40x80 (empty = PREOPEN_LEVELS; none = the first level alone)
PREOPEN_BTC5_LEVELS=          # the older way (1.154.37): BTC 5-minute's whole ladder at once, its first level first, e.g. 47x10,43x40 (empty = none);
#                               the three above, where set, stand over it
# ETH 5- and 15-minute's own (1.154.75): the same seven as BTC 5-minute's, each 0 / empty = the general one, checked the same way.
# The records of 11-16..11-26: ETH 5-minute lost $753 of its $773 on fills first seen in the last two minutes before the start,
# ETH 15-minute $502 on those of the last 20 seconds — /export 预挂明细 weighs each cancel time on the latest fills
PREOPEN_ETH5_CANCEL_SECONDS=0     # e.g. 120 (with the general entry cut-off of 180 s: it must stay at least 60 s above the cancel)
PREOPEN_ETH5_EXPIRY_SECONDS=0
PREOPEN_ETH5_ENTRY_SECONDS=0
PREOPEN_ETH5_AHEAD_MINUTES=0
PREOPEN_ETH5_PRICE_CENTS=0
PREOPEN_ETH5_SHARES=0
PREOPEN_ETH5_DEEP_LEVELS=         # none = ETH 5-minute's first level alone (its deeper levels' fills all lost, 11-16..11-26)
PREOPEN_ETH15_CANCEL_SECONDS=0    # e.g. 60
PREOPEN_ETH15_EXPIRY_SECONDS=0
PREOPEN_ETH15_ENTRY_SECONDS=0
PREOPEN_ETH15_AHEAD_MINUTES=0
PREOPEN_ETH15_PRICE_CENTS=0
PREOPEN_ETH15_SHARES=0
PREOPEN_ETH15_DEEP_LEVELS=
PREOPEN_API_KEY=            # 1.154.0: a second Predict API key for the pre-open mode alone — its own request budget (empty: PREDICT_API_KEY)
PREOPEN_API_KEYS=           # 1.154.59: further Predict API keys for the pre-open mode alone, separated by commas — each paced by itself here (1.154.60:
#                             Predict's own limits are an app's, see PREOPEN_APP_* below — keys of one app share them, and with those given one key is
#                             enough): the mode's requests go out on whichever of its keys has a token (its first key first), a cancel on another
#                             while its first key waits out a 429. A key that is another role's (PREDICT_API_KEY, the feed's, the rule taker's) is left out
PREOPEN_APP_TRADING_PER_MIN=0  # 1.154.60: Predict's own limits for the app the pre-open key is a token of, as its Rate limits page says them — Trading
#                                (1.154.63: order placement, cancellation AND the order reads — the account snapshot, the reads after a cancel — as
#                                Predict's own answers count them; /preopen shows the figures each answer gives)
PREOPEN_APP_GENERAL_PER_MIN=0  # (order placement, cancellation) and General (every other request), requests a minute; in force with both given (0 = the key keeps
#                                its one pace). Given, the mode's orders and its reads are paced apart, to 80% of each less what the bot's other keys may
#                                send, and its own concurrency (pairs placed side by side, withdrawn pairs verified, windows re-read) follows. A 429
#                                at them (another app's figures, a tier that moved) cuts the bucket refused to under what Predict did let through, and
#                                says so; the cut stays until these are changed or the bot restarts. 1.154.67: a figure given above what the
#                                key's own answers say goes by theirs (more only brings 429s)
PREDICT_RATE_AUTO=on         # 1.154.66: every other key (the bot's, the orderbook feed's, the rule taker's) paced by the limits its own answers say —
#                             half the lower of the two, 1000 a minute at most, never under PREDICT_RATE_PER_MIN; off = PREDICT_RATE_PER_MIN for each.
#                             1.154.67: General's alone where no order of the key's said Trading within half an hour (the rule taker's key)
PREOPEN_APP_AUTO=on          # 1.154.64: neither PREOPEN_APP_* given, the limits Predict's own answers on the pre-open key say (taken as the mode
#                             starts — a fresh process: from its first answers, before anything is placed); off = the key's usual pace
PREOPEN_RATE_PER_MIN=0      # 1.154.57: that key's own pace, requests a minute (0 = PREDICT_RATE_PER_MIN, as every key; else 60～1000) — for finding where
#                             Predict's limit for a key lies: raised a step at a time while a backlog is being placed, /preopen's 速度 line counting its
#                             429s. Does nothing unless PREOPEN_API_KEY is a key of the mode's own (not the bot's, the feed's or the rule taker's)
PREDICT_BOOK_API_KEY=       # 1.154.5: a Predict API key for the orderbook feed alone (REST reads, push) — its own budget; the trader keeps PREDICT_API_KEY (empty: PREDICT_API_KEY)
PREOPEN_MAX_OPEN_USD=0      # 预挂自己的预留上限，0 = 不限（默认；Predict 不锁定挂单资金，余额够一场双边就挂）；设了上限时每场双边预留价格×份数×2，和 LIVE_MAX_OPEN_USD 各算各的
# 规则吃单 (1.153.0, rules.py; README「规则吃单」): gold / oil 15-minute windows bought on the rule's side before they start whenever the
# book offers it at or under the rule's price. RULE_TAKER off | paper (只记录，不下单) | on (real orders, LIVE=on); each price in cents, 0 = that rule off
RULE_TAKER=off
RULE_GOLD_SHUT_CENTS=58   # gold, CME's daily break: 17:00–17:45 New York Mon–Thu (Beijing 06:00–06:45 winter), buy Up
RULE_GOLD_OPEN_CENTS=50   # gold, the daily reopen's first window: 18:00 New York Mon–Thu (Beijing 07:00 winter), buy Down
RULE_GOLD_0515_CENTS=58   # gold, 05:15 New York Mon–Fri (Beijing 18:15 winter, 17:15 summer), buy Down
# 1.154.14, 盘中吃单 — the two rules also buy in the window's course at a price of their own (0 = not in its course, the default): from 3 s
# after the start to 15 s before the end, each second, while the bot's own XAU card says the rule's side is ahead of the window's start —
# the shut windows: the Binance index 0.005% or more over it (2026-06..11, 380 windows: Up 98% from minute 2, October 80–92%; the index
# has moved through CME's break since June, Up 84% in all); the reopen's first: 0.02% or more under it (Down 89–91% at minutes 1–4,
# 94–99% from minute 5). In the window's first minute no dearer than before it. The window's shares and the day's cap are shared
RULE_GOLD_SHUT_LIVE_CENTS=0   # gold, the daily break's four windows, in their course: buy Up at or under this (0, or 1–97)
RULE_GOLD_OPEN_LIVE_CENTS=0   # gold, the reopen's first window, in its course: buy Down at or under this (0, or 1–97)
RULE_OIL_SHUT_CENTS=0     # oil, the daily break, buy Down: off — ties settle Up, Down won 42% (2026)
RULE_OIL_OPEN_CENTS=50    # oil, the daily reopen's first window, buy Down (1.153.2: 50, was 55 — +3¢ a share there, +8¢ at 50)
RULE_GOLD_0500_CENTS=0    # 1.153.2, found by the slot scan, off until tried on paper: gold 05:00 New York (Beijing 18:00 winter), buy Up
RULE_GOLD_1645_CENTS=0    # ...gold 16:45 New York, the last before the daily shut (Beijing 05:45 winter), buy Up
RULE_OIL_0045_CENTS=0     # ...oil 00:45 New York (Beijing 13:45 winter), buy Down
RULE_GOLD=on              # 1.153.1: gold's rules on / off by themselves...
RULE_OIL=on               # ...and oil's
RULE_GOLD_SHARES=50       # the most shares bought a gold window (RULE_SHARES, 1.153.0's, is the default of both). 1.154.15: with enough on offer one
#                           order asks for all of it (it takes what stands at the rule's price when it arrives) — LIVE_MAX_ORDER_USD no longer cuts a rule order
RULE_OIL_SHARES=50        # ...an oil window
RULE_MAX_DAY_USD=0        # the most spent a Beijing day, gold and oil together (fills at their price and fee, open orders in full); 0 = no cap
RULE_FAST_HOURS=01:00-07:00  # 1.154.12: the Beijing hours of the per-second looks (every listed window each second, prepared a minute before); several: 01:00-07:00,13:00-14:00; off = none
RULE_LEAD_MINUTES=300     # 1.154.13: how long before a window's start the makers post (5 hours): each rule window sprints around that moment; 0 = off
RULE_TAIL=on              # 1.154.55: on = the rule taker buys in a start's last two minutes too (130 s to 15 s before it). Predict takes no order with under two
#                           minutes to its expiry, so an order there is signed for ~125 s from now — up to 110 s into the window: it asks only for what
#                           the book offers, its rest is withdrawn 1.5 s on and asked again each second, and one still out at the start is told at
#                           once. off = nothing nearer than 130 s to the start (1.154.52). A window's course is not affected (nothing in its last 130 s)
RULE_API_KEY=             # 1.154.12: a Predict API key for the rule taker alone — its own budget and its own 429 cooldown (empty: PREDICT_API_KEY)
RULE_KEY_LEND=on          # 1.154.21: on = while the rule taker is idle its own key also carries the orderbook feed's reads and the pre-open mode's overflow
#                           (never from 5 minutes before the rule taker needs it: its per-second hours, the makers' moments, a window's last quarter hour);
#                           off = that key is the rule taker's alone
LIVE_READ_LEND=on         # 1.154.45: on = ...and the model trader's own reads (a cancelled order's fills, the open list, the positions) once they have
#                           waited two seconds on the bot's key for a token — used up by its orders and cancels, which go first there;
#                           off = those reads wait on the bot's key for as long as it takes, as before
# on = the model trader opens nothing while this mode runs for real; off (default) = both run, the mode's reservation
# counted in LIVE_MAX_OPEN_USD, its day's P&L in LIVE_MAX_DAILY_LOSS_USD, its fills known to the positions reconciliation
PREOPEN_EXCLUSIVE=off
# PREOPEN_DB=/data/bot.preopen.sqlite3
# LIVE=on, the configured wallet/API key, and existing exchange approvals are still required.
# LIVE_MAX_OPEN_USD also applies: choose it explicitly for the available balance / intended scope.

